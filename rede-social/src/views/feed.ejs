<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aula 05 - Feed</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-100 min-h-screen">
    <header class="bg-slate-900 text-white px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <% if (currentUser.avatarUrl) { %>
          <img src="<%= currentUser.avatarUrl %>" alt="" class="w-9 h-9 rounded-full object-cover" />
        <% } %>
        <div>
          <h1 class="text-lg font-semibold">Rede social — Aula 05</h1>
          <p class="text-slate-300 text-sm">
            Logado como <strong><%= currentUser.name %></strong>
            (<%= currentUser._count.following %> seguindo, <%= currentUser._count.followers %> seguidores)
          </p>
          <p id="notifications" class="text-rose-200 text-xs" aria-live="polite"><%= notificationCount ? `${notificationCount} novas interações` : '' %></p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/posts/new" class="bg-white text-slate-900 text-sm rounded px-3 py-1.5 hover:bg-slate-200">
          Novo post
        </a>
        <form method="post" action="/logout">
          <button type="submit" class="text-slate-300 text-sm hover:text-white">Sair</button>
        </form>
      </div>
    </header>

    <main class="max-w-4xl mx-auto mt-8 px-4 grid grid-cols-1 md:grid-cols-3 gap-6">
      <section class="md:col-span-2 flex flex-col gap-4">
        <h2 class="text-slate-500 text-sm font-medium uppercase tracking-wide">Seu feed</h2>

        <% if (feed.length === 0) { %>
          <p id="empty-feed" class="bg-white rounded-lg shadow p-6 text-sm text-slate-500">
            Ninguém que você segue postou ainda. Siga alguém na coluna ao lado.
          </p>
        <% } %>

        <div id="feed-list" class="flex flex-col gap-4">
          <% feed.forEach((post) => { %>
            <article class="bg-white rounded-lg shadow p-4" data-post-id="<%= post.id %>">
              <header class="flex items-center justify-between">
                <p class="text-sm font-medium text-slate-800"><%= post.author.name %></p>
                <p class="text-xs text-slate-400"><%= new Date(post.createdAt).toLocaleString('pt-BR') %></p>
              </header>
              <a href="/posts/<%= post.id %>" class="block group">
                <p class="text-slate-700 mt-2 group-hover:text-slate-900"><%= post.content %></p>
              </a>
              <% if (post.images.length > 0) { %>
                <div class="relative mt-3" data-carousel data-index="0">
                  <% post.images.forEach((image, index) => { %>
                    <img src="<%= image.url %>" alt="" data-carousel-image class="rounded-lg max-h-80 w-full object-cover <%= index === 0 ? '' : 'hidden' %>" />
                  <% }) %>
                  <% if (post.images.length > 1) { %>
                    <button type="button" data-carousel-prev class="absolute left-2 top-1/2 bg-white/90 rounded px-2 py-1" aria-label="Foto anterior">&#8249;</button>
                    <button type="button" data-carousel-next class="absolute right-2 top-1/2 bg-white/90 rounded px-2 py-1" aria-label="Próxima foto">&#8250;</button>
                  <% } %>
                </div>
              <% } %>
              <% if (post.tags.length > 0) { %>
                <div class="flex gap-2 mt-3 flex-wrap">
                  <% post.tags.forEach((tag) => { %>
                    <span class="text-xs bg-slate-100 text-slate-600 rounded-full px-2 py-0.5">#<%= tag.name %></span>
                  <% }) %>
                </div>
              <% } %>
              <footer class="flex items-center gap-4 mt-3 pt-3 border-t border-slate-100">
                <button type="button" data-like-post data-liked="<%= post.likedByMe %>" aria-pressed="<%= post.likedByMe %>" class="text-sm <%= post.likedByMe ? 'text-rose-600' : 'text-slate-500' %>">
                  <span data-like-count><%= post._count.likes %></span> curtidas
                </button>
                <a href="/posts/<%= post.id %>" class="text-sm text-slate-500 hover:text-slate-800">
                  <span data-comment-count><%= post._count.comments %></span> comentários
                </a>
              </footer>
              <section class="mt-3" aria-label="Comentários">
                <div data-comment-list class="divide-y">
                  <% post.comments.forEach((comment) => { %>
                    <div class="py-2" data-comment-id="<%= comment.id %>">
                      <p class="text-sm"><strong><%= comment.author.name %></strong> <span data-comment-content><%= comment.content %></span></p>
                      <div class="flex items-center gap-3 mt-1">
                        <button type="button" data-like-comment data-liked="<%= comment.likedByMe %>" class="text-xs text-slate-500"><span data-comment-like-count><%= comment._count.likes %></span> curtidas</button>
                        <% if (comment.authorId === currentUser.id) { %>
                          <button type="button" data-edit-comment class="text-xs text-slate-500">Editar</button>
                          <button type="button" data-delete-comment class="text-xs text-red-600">Apagar</button>
                        <% } %>
                      </div>
                    </div>
                  <% }) %>
                </div>
                <form data-comment-form class="flex gap-2 mt-2">
                  <input name="content" required maxlength="1000" placeholder="Escreva um comentário..." class="min-w-0 flex-1 border rounded px-3 py-2 text-sm" />
                  <button type="submit" class="bg-slate-800 text-white text-sm rounded px-3 py-2">Comentar</button>
                </form>
                <p data-action-error role="status" class="text-sm text-red-600 mt-1"></p>
              </section>
            </article>
          <% }) %>
        </div>
        <div id="feed-sentinel" data-next-cursor="<%= nextCursor ?? '' %>" class="h-8" aria-live="polite"></div>
      </section>

      <aside class="flex flex-col gap-3">
        <h2 class="text-slate-500 text-sm font-medium uppercase tracking-wide">Pessoas</h2>
        <div class="bg-white rounded-lg shadow divide-y">
          <% others.forEach((user) => { %>
            <div class="flex items-center justify-between px-4 py-3">
              <span class="text-sm text-slate-700"><%= user.name %></span>
              <% if (user.isFollowing) { %>
                <span class="text-xs text-slate-400">Já segue</span>
              <% } else { %>
                <form method="post" action="/follow">
                  <input type="hidden" name="targetId" value="<%= user.id %>" />
                  <button type="submit" class="text-xs bg-slate-800 text-white rounded px-2 py-1 hover:bg-slate-700">
                    Seguir
                  </button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      </aside>
    </main>
    <script>
      const currentUserId = <%- JSON.stringify(currentUser.id) %>;
      const sentinel = document.querySelector('#feed-sentinel');
      const feedList = document.querySelector('#feed-list');
      let nextCursor = sentinel.dataset.nextCursor || null;
      let loadingPage = false;

      function setError(card, message) {
        const output = card.querySelector('[data-action-error]');
        if (output) output.textContent = message;
      }

      function updatePostLike(button, liked, count) {
        button.dataset.liked = String(liked);
        button.setAttribute('aria-pressed', String(liked));
        button.classList.toggle('text-rose-600', liked);
        button.classList.toggle('text-slate-500', !liked);
        button.querySelector('[data-like-count]').textContent = String(count);
      }

      function commentElement(comment) {
        const item = document.createElement('div');
        item.className = 'py-2';
        item.dataset.commentId = comment.id;
        const line = document.createElement('p');
        line.className = 'text-sm';
        const author = document.createElement('strong');
        author.textContent = comment.author.name;
        const content = document.createElement('span');
        content.dataset.commentContent = '';
        content.textContent = comment.content;
        line.append(author, document.createTextNode(' '), content);
        const controls = document.createElement('div');
        controls.className = 'flex items-center gap-3 mt-1';
        const like = document.createElement('button');
        like.type = 'button';
        like.dataset.likeComment = '';
        like.dataset.liked = String(comment.likedByMe);
        like.className = 'text-xs text-slate-500';
        const count = document.createElement('span');
        count.dataset.commentLikeCount = '';
        count.textContent = String(comment._count.likes);
        like.append(count, document.createTextNode(' curtidas'));
        controls.append(like);
        if (comment.authorId === currentUserId) {
          const edit = document.createElement('button');
          edit.type = 'button';
          edit.dataset.editComment = '';
          edit.className = 'text-xs text-slate-500';
          edit.textContent = 'Editar';
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.dataset.deleteComment = '';
          remove.className = 'text-xs text-red-600';
          remove.textContent = 'Apagar';
          controls.append(edit, remove);
        }
        item.append(line, controls);
        return item;
      }

      function postElement(post) {
        const article = document.createElement('article');
        article.className = 'bg-white rounded-lg shadow p-4';
        article.dataset.postId = post.id;
        const header = document.createElement('header');
        header.className = 'flex items-center justify-between';
        const author = document.createElement('p');
        author.className = 'text-sm font-medium text-slate-800';
        author.textContent = post.author.name;
        const date = document.createElement('p');
        date.className = 'text-xs text-slate-400';
        date.textContent = new Date(post.createdAt).toLocaleString('pt-BR');
        header.append(author, date);
        const link = document.createElement('a');
        link.href = `/posts/${post.id}`;
        link.className = 'block group';
        const content = document.createElement('p');
        content.className = 'text-slate-700 mt-2 group-hover:text-slate-900';
        content.textContent = post.content;
        link.append(content);
        article.append(header, link);

        if (post.images.length) {
          const carousel = document.createElement('div');
          carousel.className = 'relative mt-3';
          carousel.dataset.carousel = '';
          carousel.dataset.index = '0';
          post.images.forEach((image, index) => {
            const img = document.createElement('img');
            img.src = image.url;
            img.alt = '';
            img.dataset.carouselImage = '';
            img.className = `rounded-lg max-h-80 w-full object-cover${index ? ' hidden' : ''}`;
            carousel.append(img);
          });
          if (post.images.length > 1) {
            for (const [direction, label, symbol, side] of [['prev', 'Foto anterior', '‹', 'left-2'], ['next', 'Próxima foto', '›', 'right-2']]) {
              const control = document.createElement('button');
              control.type = 'button';
              control.dataset[`carousel${direction[0].toUpperCase()}${direction.slice(1)}`] = '';
              control.setAttribute('aria-label', label);
              control.className = `absolute ${side} top-1/2 bg-white/90 rounded px-2 py-1`;
              control.textContent = symbol;
              carousel.append(control);
            }
          }
          article.append(carousel);
        }

        if (post.tags.length) {
          const tags = document.createElement('div');
          tags.className = 'flex gap-2 mt-3 flex-wrap';
          post.tags.forEach((tag) => {
            const label = document.createElement('span');
            label.className = 'text-xs bg-slate-100 text-slate-600 rounded-full px-2 py-0.5';
            label.textContent = `#${tag.name}`;
            tags.append(label);
          });
          article.append(tags);
        }

        const footer = document.createElement('footer');
        footer.className = 'flex items-center gap-4 mt-3 pt-3 border-t border-slate-100';
        const like = document.createElement('button');
        like.type = 'button';
        like.dataset.likePost = '';
        like.dataset.liked = String(post.likedByMe);
        like.setAttribute('aria-pressed', String(post.likedByMe));
        like.className = `text-sm ${post.likedByMe ? 'text-rose-600' : 'text-slate-500'}`;
        const count = document.createElement('span');
        count.dataset.likeCount = '';
        count.textContent = String(post._count.likes);
        like.append(count, document.createTextNode(' curtidas'));
        const commentsLink = document.createElement('a');
        commentsLink.href = `/posts/${post.id}`;
        commentsLink.className = 'text-sm text-slate-500 hover:text-slate-800';
        const commentCount = document.createElement('span');
        commentCount.dataset.commentCount = '';
        commentCount.textContent = String(post._count.comments);
        commentsLink.append(commentCount, document.createTextNode(' comentários'));
        footer.append(like, commentsLink);
        article.append(footer);

        const section = document.createElement('section');
        section.className = 'mt-3';
        const list = document.createElement('div');
        list.dataset.commentList = '';
        list.className = 'divide-y';
        (post.comments || []).forEach((comment) => list.append(commentElement(comment)));
        const form = document.createElement('form');
        form.dataset.commentForm = '';
        form.className = 'flex gap-2 mt-2';
        const input = document.createElement('input');
        input.name = 'content';
        input.required = true;
        input.maxLength = 1000;
        input.placeholder = 'Escreva um comentário...';
        input.className = 'min-w-0 flex-1 border rounded px-3 py-2 text-sm';
        const submit = document.createElement('button');
        submit.type = 'submit';
        submit.className = 'bg-slate-800 text-white text-sm rounded px-3 py-2';
        submit.textContent = 'Comentar';
        form.append(input, submit);
        const error = document.createElement('p');
        error.dataset.actionError = '';
        error.setAttribute('role', 'status');
        error.className = 'text-sm text-red-600 mt-1';
        section.append(list, form, error);
        article.append(section);
        return article;
      }

      document.addEventListener('click', async (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest('button');
        if (!button) return;
        const card = button.closest('[data-post-id]');
        if (!card) return;

        if (button.matches('[data-carousel-prev], [data-carousel-next]')) {
          const carousel = button.closest('[data-carousel]');
          const images = [...carousel.querySelectorAll('[data-carousel-image]')];
          const direction = button.hasAttribute('data-carousel-next') ? 1 : -1;
          const index = (Number(carousel.dataset.index) + direction + images.length) % images.length;
          carousel.dataset.index = String(index);
          images.forEach((image, imageIndex) => image.classList.toggle('hidden', imageIndex !== index));
          return;
        }

        const isPostLike = button.matches('[data-like-post]');
        const isCommentLike = button.matches('[data-like-comment]');
        if (isPostLike || isCommentLike) {
          const comment = button.closest('[data-comment-id]');
          const wasLiked = button.dataset.liked === 'true';
          const countElement = button.querySelector(isPostLike ? '[data-like-count]' : '[data-comment-like-count]');
          const previousCount = Number(countElement.textContent);
          const nextLiked = !wasLiked;
          const optimisticCount = previousCount + (nextLiked ? 1 : -1);
          if (isPostLike) updatePostLike(button, nextLiked, optimisticCount);
          else {
            button.dataset.liked = String(nextLiked);
            countElement.textContent = String(optimisticCount);
          }
          button.disabled = true;
          try {
            const url = isPostLike ? `/posts/${card.dataset.postId}/like` : `/comments/${comment.dataset.commentId}/like`;
            const response = await fetch(url, { method: nextLiked ? 'POST' : 'DELETE' });
            if (!response.ok) throw new Error('Não foi possível atualizar a curtida.');
            const result = await response.json();
            if (isPostLike) updatePostLike(button, result.liked, result.count);
            else {
              button.dataset.liked = String(result.liked);
              countElement.textContent = String(result.count);
            }
            setError(card, '');
          } catch (error) {
            if (isPostLike) updatePostLike(button, wasLiked, previousCount);
            else {
              button.dataset.liked = String(wasLiked);
              countElement.textContent = String(previousCount);
            }
            setError(card, error.message);
          } finally {
            button.disabled = false;
          }
          return;
        }

        if (button.matches('[data-edit-comment]')) {
          const comment = button.closest('[data-comment-id]');
          const content = comment.querySelector('[data-comment-content]');
          const updated = window.prompt('Editar comentário', content.textContent);
          if (updated === null || !updated.trim()) return;
          try {
            const response = await fetch(`/posts/${card.dataset.postId}/comments/${comment.dataset.commentId}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ content: updated }),
            });
            if (!response.ok) throw new Error('Não foi possível editar o comentário.');
            content.textContent = (await response.json()).content;
          } catch (error) {
            setError(card, error.message);
          }
          return;
        }

        if (button.matches('[data-delete-comment]') && window.confirm('Apagar este comentário?')) {
          const comment = button.closest('[data-comment-id]');
          try {
            const response = await fetch(`/posts/${card.dataset.postId}/comments/${comment.dataset.commentId}`, { method: 'DELETE' });
            if (!response.ok) throw new Error('Não foi possível apagar o comentário.');
            comment.remove();
            const count = card.querySelector('[data-comment-count]');
            count.textContent = String(Number(count.textContent) - 1);
          } catch (error) {
            setError(card, error.message);
          }
        }
      });

      document.addEventListener('submit', async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || !form.matches('[data-comment-form]')) return;
        event.preventDefault();
        const card = form.closest('[data-post-id]');
        const input = form.elements.namedItem('content');
        const submit = form.querySelector('button[type="submit"]');
        submit.disabled = true;
        try {
          const response = await fetch(`/posts/${card.dataset.postId}/comments`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: input.value }),
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || 'Não foi possível comentar.');
          card.querySelector('[data-comment-list]').prepend(commentElement(result));
          const count = card.querySelector('[data-comment-count]');
          count.textContent = String(Number(count.textContent) + 1);
          form.reset();
          setError(card, '');
        } catch (error) {
          setError(card, error.message);
        } finally {
          submit.disabled = false;
        }
      });

      if ('IntersectionObserver' in window && nextCursor) {
        const observer = new IntersectionObserver(async ([entry]) => {
          if (!entry.isIntersecting || loadingPage || !nextCursor) return;
          loadingPage = true;
          sentinel.textContent = 'Carregando...';
          try {
            const response = await fetch(`/api/feed?cursor=${encodeURIComponent(nextCursor)}&limit=10`);
            if (!response.ok) throw new Error('Não foi possível carregar mais posts.');
            const page = await response.json();
            page.posts.forEach((post) => feedList.append(postElement(post)));
            document.querySelector('#empty-feed')?.remove();
            nextCursor = page.nextCursor;
            sentinel.textContent = '';
            if (!nextCursor) observer.disconnect();
          } catch (error) {
            sentinel.textContent = error.message;
          } finally {
            loadingPage = false;
          }
        }, { rootMargin: '300px' });
        observer.observe(sentinel);
      }
    </script>
  </body>
</html>
